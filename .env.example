# Copy this file to .env and fill in your own values. Never commit .env.
# Server
DATABASE_URL=postgres://username:password@localhost:5432/sweety
PORT=5000
# Used for login sessions (step 2). Any long random string works.
JWT_SECRET=change-me-to-a-long-random-string
# Client (Vite reads variables starting with VITE_)
VITE_API_URL=http://localhost:5000
